{
  "name": "patchy-doctor-cli",
  "version": "0.1.0",
  "description": "Local read-only PatchyHub-style analyzer that turns GHL evidence into Doctor run plans.",
  "type": "module",
  "bin": {
    "patchy-doctor": "./bin/patchy-doctor.mjs"
  },
  "scripts": {
    "analyze:burton": "node ./bin/patchy-doctor.mjs analyze --account burton --input ../tmp --out ../tmp/patchy-doctor",
    "smoke": "node ./bin/patchy-doctor.mjs analyze --account burton --input ../tmp --out ../tmp/patchy-doctor-smoke"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
